.{
    .name = .fluxion_debugdraw,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x524bb3139223f3fb,
    .dependencies = .{
        // Points, matrices and boxes. Pinned to the commit `fluxion-rhi` and
        // the engine pin: a path here would be a second copy of the package,
        // and its `Vec3` a different type from theirs.
        .fluxion_math = .{
            .url = "git+https://github.com/kisstp2006/fluxion-math#92afdbddbf930369265d24136402c7eb5dd8f70e",
            .hash = "fluxion_math-0.1.0-dfpZBeNUBAAwUMriLKaOTRBWGFmfY53_jyYuMUxkPYek",
        },

        // What the `fluxion_debugdraw_rhi` module draws with and writes its
        // shaders in. Lazy, and asked for only with `-Drenderer`, which is on
        // unless a consumer turns it off: a program with its own renderer
        // fetches neither.
        .fluxion_rhi = .{
            .url = "git+https://github.com/kisstp2006/fluxion-rhi#7e9fa3fbb2b14371e8d6fb248739b63256301bd8",
            .hash = "fluxion_rhi-0.1.0--pvwDyztDgCUkDdfoxajCpfsluu1VcPAojnDDqh2BJNk",
            .lazy = true,
        },
        .fluxion_shader = .{
            .url = "git+https://github.com/kisstp2006/fluxion-shader#2f6ebe660304cab735e1c2669663ebd0dd68d40f",
            .hash = "fluxion_shader-0.1.0-FqFMEvtOBwDYCkbQOVR1PHrJ4A6IVjdh5FDnMNgeOh8f",
            .lazy = true,
        },

        // The window and the PNG the example needs, and nothing else does.
        .fluxion_platform = .{
            .url = "git+https://github.com/kisstp2006/fluxion-platform#a3f3707277d8a4fdc8100a6edd85bc779284de52",
            .hash = "fluxion_platform-0.1.0-WsOjUUdvFwCsEYeB1XX5RhTBrRB3ElWncnw7VZ6cR99F",
            .lazy = true,
        },
        .fluxion_image = .{
            .url = "git+https://github.com/kisstp2006/fluxion-image#79463ef201f11e15ada014467c0ad1d58b2a882d",
            .hash = "fluxion_image-0.1.0-fyJkdS7vAAB1p43VSutvpxQB32hIcvJb3fGSZbo_qeha",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
        "LICENSE",
    },
}
